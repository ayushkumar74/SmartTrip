# Environment variables for SmartTrip Backend

# Environment
NODE_ENV=development

# Port to run the server on
PORT=5000

# CORS settings
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database URL for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# DO NOT COMMIT THE REAL .env FILE
DATABASE_URL="postgresql://postgres:password@localhost:5432/smarttrip?schema=public"

# Future Auth Secrets
JWT_SECRET=super_secret_jwt_key_here_min_10_chars
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 (Configure in Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# OTP Configuration
OTP_PROVIDER=dev
OTP_PROVIDER_API_KEY=your_provider_api_key
OTP_PROVIDER_SENDER_ID=SMARTTRIP
